# Copy this file to .env and fill in your values
# Never commit .env — it is in .gitignore

BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
AWS_DEFAULT_REGION=us-east-1

# AWS profile name set by saml2aws login (usually "saml")
AWS_PROFILE=saml

# Filled automatically by deploy.ps1 after `cdk deploy --all`
# Format: arn:aws:states:<region>:<account-id>:stateMachine:TheraScoutOpportunityScan
STATE_MACHINE_ARN=

# Bedrock Knowledge Base ID (output from TheraScout-KnowledgeBase CDK stack)
# Leave blank until KB is deployed and the OpenSearch index is created
KNOWLEDGE_BASE_ID=

# PostgreSQL connection string
# Local dev:  postgresql://localhost/therascout
# RDS (ECS):  postgresql://<user>:<pass>@<rds-endpoint>:5432/therascout
# Leave blank to run without database (history and weights features disabled)
DATABASE_URL=
